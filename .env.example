# Conservative data-quality gates
STOCK_RADAR_MIN_COVERAGE_PCT=97.0
STOCK_RADAR_MAX_BAR_AGE_DAYS=4
STOCK_RADAR_MAX_OUTPUT_AGE_HOURS=36
STOCK_RADAR_MIN_RANK_COVERAGE_COMPANY_PCT=70
STOCK_RADAR_MIN_RANK_COVERAGE_FUND_PCT=70
STOCK_RADAR_MIN_RANK_COVERAGE_CRYPTO_PCT=70
STOCK_RADAR_MIN_RANK_COVERAGE_OTHER_PCT=70
STOCK_RADAR_MIN_COMPANY_FUNDAMENTAL_COVERAGE_PCT=60

# Bounded optional deep-fundamental refresh
STOCK_RADAR_DEEP_MAX=60

# Unvalidated paper-simulation assumptions
STOCK_RADAR_MIN_DOLLAR_VOLUME=20000000
STOCK_RADAR_MAX_PAPER_ATR_PCT=5
STOCK_RADAR_MAX_PAPER_ANNUAL_VOL_PCT=60
STOCK_RADAR_MAX_PAPER_PER_SECTOR=3
STOCK_RADAR_MAX_PAPER_PER_COUNTRY=4
STOCK_RADAR_PAPER_ORDER_MAX_AGE_DAYS=7
STOCK_RADAR_PAPER_SLIPPAGE_BPS=10
STOCK_RADAR_PAPER_COMMISSION_BPS=5

# Set once, only after reviewing the frozen legacy migration:
# STOCK_RADAR_START_NEW_PAPER=1

# Safe smoke run (all JSON writes redirected; limit is optional):
# STOCK_RADAR_DRY_RUN=1
# STOCK_RADAR_DRY_RUN_DIR=C:\path\to\Stock-Radar\data\dry-run
# STOCK_RADAR_MAX_SYMBOLS=25
# STOCK_RADAR_MARKET_DATA_ONLY=1
